# ---------------------------------------------------------------------------
# AI Finance Controller — environment
# Copy to `.env` and fill in. Never commit the real .env.
# ---------------------------------------------------------------------------

# --- app -------------------------------------------------------------------
ENV=development
LOG_LEVEL=INFO
API_PREFIX=/api
# Comma-separated origins, or * for all. Set your Render frontend URL here.
CORS_ORIGINS=http://localhost:5173

# --- storage ---------------------------------------------------------------
# On Render, point this at a mounted disk (e.g. /var/data) so runs survive deploys.
DATA_DIR=./var/data
# SQLite locally. On Render, paste the Postgres Internal Database URL.
DATABASE_URL=sqlite:///./var/finance_controller.db

# --- engine ----------------------------------------------------------------
DUCKDB_THREADS=4
DUCKDB_MEMORY_LIMIT=2GB
AMOUNT_SCALE=100
DEFAULT_CURRENCY=INR

# Matching tolerances
TIME_WINDOW_HOURS=48
SETTLEMENT_WINDOW_DAYS=7
AMOUNT_TOLERANCE_MINOR=100
FEE_TOLERANCE_MINOR=50
DEFAULT_FEE_BPS=200
AMOUNT_BUCKET_MINOR=10000

# Confidence routing
AUTO_RESOLVE_THRESHOLD=0.95
AI_INVESTIGATE_THRESHOLD=0.80

# --- AI --------------------------------------------------------------------
# Which provider runs the exception controller.
#   auto      -> whichever key below is set (Anthropic wins if both are)
#   anthropic -> Claude
#   gemini    -> Google Gemini
AI_PROVIDER=auto
AI_ENABLED=true

# Set ONE of these. Leave both empty and the engine still runs end to end —
# exceptions simply route to the human queue instead of the AI lane.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5
# Required only for identity-linked keys (Console -> Settings -> Workspaces).
ANTHROPIC_WORKSPACE_ID=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_EFFORT=high
AI_MAX_TOKENS=8000
AI_TIMEOUT_SECONDS=90
AI_BATCH_SIZE=12
AI_MAX_CONCURRENCY=4
# Hard ceiling on model calls per run. Exceptions beyond this go to humans,
# and the API reports exactly how many were skipped.
AI_MAX_EXCEPTIONS_PER_RUN=500

# --- cache -----------------------------------------------------------------
# Optional. Without it, verdict caching falls back to an in-process LRU.
REDIS_URL=
CACHE_TTL_SECONDS=604800

# --- benchmark -------------------------------------------------------------
BENCH_SIZES=1000,10000,100000
